    {
      "title": "Clear finding title",
      "severity": "high",
      "asset": "https://affected.example.com/path",
      "description": "Detailed description of what was found",
      "evidence": "Exact output snippet proving the finding",
      "poc": "Step-by-step reproduction steps",
      "impact": "What an attacker could do with this",
      "remediation": "How to fix this",
      "cwe": "CWE-XXX or null",
      "cvss": 7.5,
      "confidence": 0.85
